<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Mikoto.Fluent.EditGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="using:Microsoft.UI.Xaml.Controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:cvter="using:Mikoto.Fluent.Converters" 
      xmlns:local112="using:Mikoto.Core.Models" 
      xmlns:local1121="using:Mikoto.Core.Models.AddGame">
    <Page.Resources>
        <cvter:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <cvter:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
        <cvter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <ScrollViewer Padding="32,24">
            <Grid ColumnDefinitions="*, 320" ColumnSpacing="24" HorizontalAlignment="Stretch">

                <StackPanel Grid.Column="0" Spacing="20">
                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="游戏配置" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                            <TextBlock Text="管理 Hook 注入参数、运行架构及文本处理算法" 
                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1" Content="启动游戏" 
            Style="{StaticResource AccentButtonStyle}" 
            Width="120" VerticalAlignment="Center"
            Command="{x:Bind ViewModel.GameItem.StartGameCommand}" />

                        <Button Grid.Column="2" Content="LE启动游戏" 
            Width="120" VerticalAlignment="Center"
            Command="{x:Bind ViewModel.GameItem.LEStartGameCommand}" />
                    </Grid>
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="基本参数" Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="20">
                                <Border Grid.Column="0" Width="80" Height="80" 
                    VerticalAlignment="Top"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image Source="{x:Bind (ImageSource)ViewModel.GameItem.GameIcon, Mode=OneWay}" 
                       Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="12">
                                    <TextBox Header="游戏名称" 
                         Text="{x:Bind ViewModel.GameItem.GameInfo.GameName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="文件路径" 
                         Text="{x:Bind ViewModel.GameItem.GameInfo.FilePath, Mode=OneWay}" 
                         IsReadOnly="True"/>
                                </StackPanel>
                            </Grid>

                            <ToggleSwitch Header="运行环境架构" OnContent="64 位 (x64)" OffContent="32 位 (x86)"
                      IsOn="{x:Bind ViewModel.GameItem.GameInfo.Isx64, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="详细设置" Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                                <ComboBox Grid.Column="0" Header="源语言" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.LanguageViewModel.LangList}"
                                          SelectedItem="{x:Bind ViewModel.LanguageViewModel.SelectedSourceLanguage, Mode=TwoWay}" >
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="local1121:LanguageItem">
                                            <TextBlock Text="{x:Bind DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Grid.Column="1" Header="目标语言" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.LanguageViewModel.LangList}"
                                          SelectedItem="{x:Bind ViewModel.LanguageViewModel.SelectedTargetLanguage, Mode=TwoWay}" >
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="local1121:LanguageItem">
                                            <TextBlock Text="{x:Bind DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <TextBox Header="Hook Code" PlaceholderText="/H..." FontFamily="Consolas"
                                     Text="{x:Bind ViewModel.GameItem.GameInfo.HookCode, Mode=TwoWay}" />
                            <TextBox Header="Misaka Hook Code" FontFamily="Consolas"
                                     Text="{x:Bind ViewModel.GameItem.GameInfo.MisakaHookCode, Mode=TwoWay}" />

                            <ComboBox Header="源文本预处理方法" 
                                      ItemsSource="{x:Bind ViewModel.RepairFunctionViewModel.FunctionList}"
                                      SelectedItem="{x:Bind ViewModel.RepairFunctionViewModel.SelectedRepairFunction, Mode=TwoWay}" >
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local112:RepairFunctionItem">
                                        <TextBlock Text="{x:Bind DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <TextBox Grid.Column="0" Header="参数 A" Text="{x:Bind ViewModel.GameItem.GameInfo.RepairParamA, Mode=TwoWay}" />
                                <TextBox Grid.Column="1" Header="参数 B" Text="{x:Bind ViewModel.GameItem.GameInfo.RepairParamB, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                        <Button Content="保存设置" Style="{StaticResource AccentButtonStyle}" Width="120" Command="{x:Bind ViewModel.SaveCommand}" />
                        <Button Content="放弃修改" Width="100" Command="{x:Bind ViewModel.CancelCommand}" />
                        <ui:InfoBar IsOpen="{x:Bind ViewModel.ShowSuccessInfo, Mode=TwoWay}" Title="已保存" Severity="Success" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                Visibility="{x:Bind ViewModel.GameItem.IsSearchingMetadata, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressRing IsActive="True" Width="40" Height="40" />
                        <TextBlock Text="正在搜索VNDB..." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Spacing="16" 
                            Visibility="{x:Bind ViewModel.GameItem.GameMetadata.VndbId, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="VNDB 详情预览" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <Border CornerRadius="8" BorderThickness="1" 
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
            Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="12">
                            <StackPanel Spacing="12">
                                <Image Source="{x:Bind ViewModel.GameItem.GameMetadata.CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" 
       Stretch="UniformToFill" />

                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.GameItem.GameMetadata.NativeTitle, Mode=OneWay}" 
                           TextWrapping="Wrap" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.GameItem.GameMetadata.Title, Mode=OneWay}" 
                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE902;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.GameItem.GameMetadata.Developer, Mode=OneWay}" 
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE787;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.GameItem.GameMetadata.ReleaseDate, Mode=OneWay}" 
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <MenuFlyoutSeparator Margin="-12,0" />

                                <Grid ColumnDefinitions="*, *">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="VNDB 评分" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="Orange" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.GameItem.GameMetadata.Score, Mode=OneWay}" 
                                   FontWeight="Bold" FontSize="18" Foreground="Orange"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="VNDB ID" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <HyperlinkButton Content="{x:Bind ViewModel.GameItem.GameMetadata.VndbId, Mode=OneWay}"
                     Command="{x:Bind ViewModel.GameItem.OpenVndbWebCommand}"
                     FontWeight="SemiBold" FontSize="18" Padding="0" MinWidth="0" MinHeight="0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border 
                        Visibility="{x:Bind ViewModel.GameItem.GameMetadata.Description, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                        CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="剧情简介" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColorLight2}"/>
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{x:Bind ViewModel.GameItem.GameMetadata.Description, Mode=OneWay}" 
                           TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>